# Copy to `.env` in the repository root — every app reads that one file.
#   cp .env.example .env

# --- Database (docker compose -f docker-compose.dev.yaml up -d) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5449/postgres

# Tests use a derived <name>_test database automatically; override only if needed:
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5449/postgres_test

# --- Auth ---
# Generate a real secret: openssl rand -base64 48
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRES_IN_MINUTES=15
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_RESET_TTL_MINUTES=15

# --- URLs ---
# Platform first, admin second. The first origin is also used for
# password-reset links and the Google callback redirect.
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
VITE_API_URL=http://localhost:8000

# --- Optional: Google sign-in ---
# Empty = the "Continue with Google" route answers 503; email + password
# keeps working. Redirect URI to register: http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: email (Resend) ---
# Empty = password-reset links are printed to the API console instead.
# The sandbox sender below can only email your own Resend account address.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- Optional: AI drafts (OpenRouter) ---
# Empty = only "Draft with AI" is disabled (503); everything else keeps working.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Production ---
# NODE_ENV=production   # Secure cookies; a missing RESEND_API_KEY becomes a 503
