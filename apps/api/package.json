{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "pnpm run with-env -- tsx watch src/index.ts",
    "build": "pnpm run with-env -- tsc",
    "start": "node dist/index.js",
    "with-env": "dotenv -e ../../.env",
    "db:migrate": "pnpm prisma migrate dev",
    "db:generate": "pnpm prisma generate",
    "db:studio": "pnpm prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
