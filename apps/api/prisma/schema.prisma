generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum PipelineStage {
  NEW
  CONTACTED
  REPLIED
  CALL_SCHEDULED
  CLOSED_WON
  CLOSED_LOST

  @@map("pipeline_stage")
}

enum ContactChannel {
  EMAIL
  LINKEDIN
  PHONE
  OTHER

  @@map("contact_channel")
}

enum ActivityOutcome {
  sent
  replied
  no_response
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  username  String?
  password  String?  @map("password_hash")
  googleId  String?  @unique
  role      UserRole @default(USER)
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  passwordResetTokens  PasswordResetToken[]
  refreshTokens        RefreshToken[]
  prospects            Prospect[]
  activities           Activity[]
  tags                 Tag[]
  roleChangesPerformed RoleChangeLog[]      @relation("RoleChangeActor")
  roleChangesReceived  RoleChangeLog[]      @relation("RoleChangeTarget")

  @@map("users")
}

// Refresh token disimpan sebagai hash (bukan raw) — sama seperti
// PasswordResetToken — supaya kalau tabel ini bocor, token tidak bisa
// dipakai langsung. revokedAt dipakai untuk logout & rotasi (lihat
// credential.service.ts:rotateRefreshToken): setiap refresh menerbitkan
// token baru dan me-revoke yang lama, supaya token yang dicuri & dipakai
// ulang oleh penyerang akan terdeteksi invalid setelah pemilik asli refresh.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// Audit trail untuk "siapa mengubah role siapa" — dicatat setiap kali
// PATCH /api/admin/users/:id/role benar-benar mengubah nilai role (bukan
// no-op set ke role yang sama), lihat admin.service.ts.
model RoleChangeLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  fromRole  UserRole @map("from_role")
  toRole    UserRole @map("to_role")
  createdAt DateTime @default(now()) @map("created_at")

  actor  User @relation("RoleChangeActor", fields: [actorId], references: [id])
  target User @relation("RoleChangeTarget", fields: [targetId], references: [id])

  @@index([targetId])
  @@map("role_change_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Prospect {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  name         String
  company      String?
  channel      ContactChannel?
  stage        PipelineStage   @default(NEW)
  notes        String?
  followUpDate DateTime?       @map("follow_up_date") @db.Date
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id])
  activities Activity[]
  tags       ProspectTag[]

  @@index([userId])
  @@index([userId, stage])
  @@index([userId, followUpDate], name: "idx_followup_due")
  @@map("prospects")
}

model Activity {
  id           String          @id @default(uuid()) @db.Uuid
  prospectId   String          @map("prospect_id") @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  channel      ContactChannel
  outcome      ActivityOutcome
  messageText  String?         @map("message_text")
  activityDate DateTime        @map("activity_date") @db.Date
  createdAt    DateTime        @default(now()) @map("created_at")

  prospect Prospect @relation(fields: [prospectId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([prospectId])
  @@index([userId])
  @@index([activityDate])
  @@map("activities")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id])
  prospects ProspectTag[]

  @@map("tags")
}

model ProspectTag {
  prospectId String @map("prospect_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  prospect Prospect @relation(fields: [prospectId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([prospectId, tagId])
  @@map("prospect_tags")
}
